# Clerk application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk Billing plan IDs (public identifiers, not secrets)
NEXT_PUBLIC_CLERK_STARTER_PLAN_ID=
NEXT_PUBLIC_CLERK_PRO_PLAN_ID=

# Supabase project and public storage bucket
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL. Use the pooled URL for app queries and a direct URL for Prisma CLI.
# DIRECT_URL may be the same as DATABASE_URL when no pooler is used.
DATABASE_URL=
DIRECT_URL=

# Google Gemini
GEMINI_API_KEY=

# Arcjet
ARCJET_KEY=
